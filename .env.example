# Database Connection (PostgreSQL - Neon, Supabase, Vercel Postgres, or Local PG)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicevault_med?schema=public"

# Authentication Secret (Used for JWT cookie signing - SHA256 length hex/string)
AUTH_SECRET="voicevault_med_secure_jwt_secret_key_32bytes_min_length_2026!"

# IPFS Pinata Provider Integration (Optional for local dev - fallback mock adapter auto-engages if omitted)
IPFS_PROVIDER="pinata"
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"

# Seed Credentials (Default generated values for quick testing)
SEED_STAFF_EMAIL="staff@voicevault.med"
SEED_STAFF_PASSWORD="StaffPassword123!"
